# Which published image build this stack runs. Leave as latest for production:
# CI moves :latest only on the default branch, so it always points at released
# code. Set it to:
#   dev      — track the dev branch, for a test instance
#   0.2.0    — pin an exact release, or roll back to one after a bad upgrade
# Changing it takes effect on `docker compose pull && docker compose up -d`.
# See RELEASING.md.
IMAGE_TAG=latest

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=prism
DB_USER=prism
# PRISM refuses to start if this is left as "changeme".
DB_PASSWORD=

# LDAP / Active Directory — OPTIONAL.
# Set LDAP_ENABLED=true and fill in the variables below to enable Active Directory
# authentication. When false, only local accounts can sign in.
# Run setup.sh to configure interactively.
LDAP_ENABLED=false
LDAP_URL=ldap://your-dc.domain.local
LDAP_BASE_DN=DC=domain,DC=local
LDAP_BIND_DN=CN=svc-prism,OU=Service Accounts,DC=domain,DC=local
LDAP_BIND_PASSWORD=changeme
LDAP_USER_FILTER=(sAMAccountName={{username}})

# REQUIRED. Signs session cookies. PRISM refuses to start if this is unset,
# left as a placeholder, or shorter than 32 characters.
#   Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Encrypts credentials stored in the database (LDAP bind password, license
# keys, calendar OAuth tokens). Strongly recommended: without it PRISM falls
# back to deriving the key from SESSION_SECRET, which means rotating
# SESSION_SECRET makes all previously stored credentials unreadable.
#   Generate one with:  openssl rand -hex 32
# ENCRYPTION_KEY=

NODE_ENV=production

# Whether to trust X-Forwarded-For for the client's IP address, which rate
# limiting keys on. Leave unset (or "false") when the backend is reachable
# directly. Set to 1 only when it sits behind exactly one trusted reverse
# proxy that sets the header — the bundled docker-compose.yml does this for
# you. Trusting the header on a directly-reachable backend lets a client forge
# its source IP and bypass the login rate limiter entirely.
# TRUST_PROXY=1

# --- Optional extras ---
# Root password for the MariaDB container (compose only).
DB_ROOT_PASSWORD=rootchangeme

# Bootstrap local admin — created automatically on first migration if a user with
# this username does not already exist. It is a real local account (admin role).
# Consider deleting this account once other admin accounts are set up.
# PRISM refuses to start while this is left as a placeholder. Choose a strong
# unique value, or remove the variable once the admin account exists.
BOOTSTRAP_LOCAL_USERNAME=admin
BOOTSTRAP_LOCAL_PASSWORD=

# Where ticket attachments are stored inside the backend container (volume mount).
UPLOAD_DIR=/uploads

# Host port PRISM is served on. Change this if port 80 is already in use.
APP_PORT=8080

# Set to "true" only when serving over HTTPS (e.g. behind a TLS-terminating proxy).
# Leave as "false" for plain HTTP deployments — browsers refuse to send Secure
# cookies over HTTP (except localhost), which breaks authentication.
COOKIE_SECURE=false

# Allowed CORS origin(s) for the API, comma-separated. Only needed when the
# frontend is served from a different origin than the backend (e.g. a separate
# dev server hitting the backend directly). In the standard Docker Compose setup
# the nginx reverse proxy makes all requests same-origin, so leave this unset.
# CORS_ORIGIN=http://localhost:8080

# Public URL this PRISM instance is reachable at, no trailing slash. Used to
# build absolute links that go out in emails to people without a PRISM login
# (currently: CSAT survey links). Falls back to http://localhost:$APP_PORT if
# unset, which only works for local testing — set this for real deployments.
# PUBLIC_APP_URL=https://helpdesk.example.com
