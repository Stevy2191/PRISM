#!/bin/bash
# PRISM Agent .pkg: owners and modes, the command-line link, the logs
# folder, then start the service and (for whoever is at the screen) the
# menu-bar app. The enrollment, if any, is kept from before.
set -u
DATA="/Library/Application Support/PRISM"
chown -R root:wheel "$DATA/bin" "/Applications/Utilities/PRISM Agent.app" \
  /Library/LaunchDaemons/com.prism.agent.plist /Library/LaunchAgents/com.prism.tray.plist
chmod 0755 "$DATA" "$DATA/bin"
chown root:wheel "$DATA"
mkdir -p /usr/local/bin /Library/Logs/PRISM
ln -sfn "$DATA/bin/prism-agent" /usr/local/bin/prism-agent

# An install link's package (8d) is named PRISM-Agent-Setup_<host>_<key>.pkg:
# enroll from its name before the service starts. Any other name changes
# nothing; a refused key fails the install so the person knows to ask IT.
# (installer passes the package's path as $1; PACKAGE_PATH is the same.)
pkg="${1:-${PACKAGE_PATH:-}}"
case "$(/usr/bin/basename "$pkg")" in
  PRISM-Agent-Setup_*)
    "$DATA/bin/prism-agent" enroll --from-installer "$pkg" || exit 1 ;;
esac

/bin/launchctl bootout system/com.prism.agent 2>/dev/null || true
/bin/launchctl bootstrap system /Library/LaunchDaemons/com.prism.agent.plist

uid=$(/usr/bin/stat -f %u /dev/console 2>/dev/null || echo 0)
if [ "$uid" -ge 500 ] 2>/dev/null; then
  /bin/launchctl bootout "gui/$uid/com.prism.tray" 2>/dev/null || true
  # Any other copy still running (opened by hand, or from before an update)
  # would stay beside the new one as a second menu bar icon.
  /usr/bin/pkill -U "$uid" -x prism-tray 2>/dev/null || true
  /bin/sleep 1
  /bin/launchctl bootstrap "gui/$uid" /Library/LaunchAgents/com.prism.tray.plist 2>/dev/null || true
fi
exit 0
