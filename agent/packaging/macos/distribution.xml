<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>PRISM Agent</title>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.prism.agent"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.prism.agent" visible="false">
        <pkg-ref id="com.prism.agent"/>
    </choice>
    <pkg-ref id="com.prism.agent" version="__VERSION__" onConclusion="none">prism-agent-component.pkg</pkg-ref>
</installer-gui-script>
